# Copy to .env and adjust. Never commit the real .env.

NODE_ENV=development
PORT=3000

# Public origin users type into the browser. Used for links in emails and to decide
# whether cookies get the Secure flag. In dev the Angular dev server (4200) proxies /api to :3000.
APP_URL=http://localhost:4200

# --- Where the website talks to the API ---
# Builds of the website (npm run build) ask for this when it is not set. Leave it empty when the API is served from the
# same origin as the website (the default setup). It ends up in the build's config.json and can be edited there later.
#   OS_PLANNER_API_URL=https://api.example.com
OS_PLANNER_API_URL=
# Websites (origins, comma-separated) allowed to call this API from another origin. APP_URL is always allowed.
CORS_ORIGINS=
# Refresh-cookie SameSite: strict (same site, incl. subdomains of one domain), lax, or none (unrelated domains; needs an https APP_URL).
COOKIE_SAMESITE=strict

# --- Database (MySQL 8.4) ---
# The development password (notes) is refused in production: with docker compose set MYSQL_PASSWORD before the first start
# (it only sets the password of a new volume; see README "Secrets" to change it later). MYSQL_ROOT_PASSWORD likewise.
# MYSQL_PASSWORD=
# MYSQL_ROOT_PASSWORD=
MYSQL_PORT=3306
DATABASE_URL=mysql://notes:notes@localhost:3306/notes
SHADOW_DATABASE_URL=mysql://notes:notes@localhost:3306/notes_shadow

# --- Secrets (>= 32 chars, generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))") ---
JWT_ACCESS_SECRET=change-me-access-secret-change-me-access
JWT_MEDIA_SECRET=change-me-media-secret-change-me-media-

# --- Mail ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="OS_Planner <no-reply@os-planner.local>"

# --- Storage ---
DATA_DIR=./data
MAX_IMAGE_MB=20
MAX_VIDEO_MB=500
USER_QUOTA_MB=2048
# Defaults for teams and projects (an instance admin can override any of them per user, team or project).
# PROJECT_QUOTA_MB=0 means a project is limited only by its team.
TEAM_QUOTA_MB=10240
PROJECT_QUOTA_MB=0
MAX_MEMBERS_PER_TEAM=100
MAX_PROJECTS_PER_TEAM=50
# Roles of one team (team and project roles together, @everyone not counted).
MAX_ROLES_PER_TEAM=100
# The audit log keeps entries this long; a nightly job removes older ones.
AUDIT_RETENTION_DAYS=365

# --- Live connection (Socket.IO at /api/realtime) ---
# Only when you run SEVERAL server instances: they share live events through this Redis. Leave empty for one instance.
#   docker compose --profile scale up -d redis
REDIS_URL=

# --- Co-editing (Hocuspocus/Yjs at /api/collab) ---
# A page is written to the database this long after its last edit (and at least this often while people keep typing); shorter
# means search and exports see an edit sooner, longer means fewer writes. Open co-editing connections are checked against what
# the person may still do this often (a role, share or membership change closes them at once; this is the backstop).
COLLAB_DEBOUNCE_MS=2000
COLLAB_MAX_DEBOUNCE_MS=10000
COLLAB_RECHECK_MS=20000
# Pages that predate co-editing get their live document built in the background at start-up (a page is also built the first
# time somebody opens it). Switch off to build only on open.
COLLAB_MIGRATE_ON_START=true

# --- Calendar sync (ICS feeds and followed calendars) ---
# Followed calendars (an ICS address a person gives) may be fetched over plain http:// (and webcal: may fall back to it). Default: allowed
# outside production, refused in production. The fetcher never reaches private networks (loopback, 10/8, 172.16/12, 192.168/16, link-local
# and cloud metadata, IPv6 equivalents): list here the hosts it may reach anyway (comma-separated: host, host:port or an IP address).
# ICS_ALLOW_HTTP=false
ICS_PRIVATE_ALLOWLIST=
# Storage the followed calendars of one person may take together, in MB (a refresh that would exceed it is refused).
EXTERNAL_CALENDAR_MAX_MB=5
# The private feed addresses people give to Google Calendar, Outlook or Apple Calendar are on the API's own address
# (OS_PLANNER_API_URL, or else APP_URL): calendar apps do not run the website.

# --- Notifications (mentions, the inbox, Web Push and email about a chat) ---
# Web Push needs a VAPID key pair: `npx web-push generate-vapid-keys`. Without both keys push is off and the website hides the option.
# VAPID_SUBJECT is an address the push services can reach you at (mailto:you@example.com or https://planner.example.com).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Push services to accept besides the browsers' own (Google, Mozilla, Apple, Microsoft): comma-separated origins. Leave empty.
PUSH_EXTRA_ENDPOINTS=
# A person with no activity on any open page for this long counts as away (email "only when I'm away").
NOTIFY_AWAY_SECONDS=600
# At most one email per chat and person in this many minutes; and at most one push per person and channel in this many seconds.
NOTIFY_EMAIL_INTERVAL_MINUTES=15
NOTIFY_PUSH_COALESCE_SECONDS=10
# How often waiting emails are looked at (seconds); 0 turns the sender off.
NOTIFY_SWEEP_SECONDS=30

# --- Voice and video channels (optional; README "Voice and video") ---
# Needs a LiveKit media server (`docker compose --profile voice up -d livekit`). Without all three of LIVEKIT_URL, LIVEKIT_API_KEY and
# LIVEKIT_API_SECRET the feature is off and the website shows no voice option. The key and secret are yours to invent: the server and
# LiveKit only have to agree (the compose service reads the same two variables). The secret must be at least 32 characters.
# The address browsers connect to (wss:// behind TLS; ws://localhost:7880 for local tests):
LIVEKIT_URL=
# Where THIS server reaches LiveKit's API when that differs from LIVEKIT_URL (inside docker: http://livekit:7880). Default: LIVEKIT_URL over http(s).
LIVEKIT_API_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Where LiveKit sends its webhook (it tells the server who is in which channel). From inside the livekit container the app is http://server:3000
# when both run in compose; with the app on your host, http://host.docker.internal:3000.
# LIVEKIT_WEBHOOK_URL=http://server:3000/api/voice/webhook
# Behind NAT, let LiveKit find its public address.
# LIVEKIT_USE_EXTERNAL_IP=false
# The signalling port is published on this machine only; LIVEKIT_BIND=0.0.0.0 opens it (plain ws: put TLS in front, see the README).
# LIVEKIT_BIND=127.0.0.1
# Most people in one voice channel (a channel can set its own limit) and in all voice channels of one team (an administrator can set another number per team).
VOICE_MAX_PARTICIPANTS=25
VOICE_TEAM_MAX_PARTICIPANTS=100
# How often the server compares who is in voice channels with LiveKit and re-checks permissions (seconds); 0 turns the check off.
VOICE_CHECK_SECONDS=30
# Host name of the media server for the HTTPS proxy (docker compose --profile proxy): LIVEKIT_URL=wss://<this>
# OS_PLANNER_LIVEKIT_DOMAIN=voice.example.com

# --- Instance administrators: comma-separated email addresses. Only a verified address counts. ---
# They get an Administration area (accounts, quota overrides, creating teams).
ADMIN_EMAILS=

# --- HTTPS reverse proxy (docker compose --profile prod --profile proxy; see README "HTTPS reverse proxy") ---
# Then also set APP_URL=https://<OS_PLANNER_DOMAIN> and TRUST_PROXY=true.
# OS_PLANNER_DOMAIN=planner.example.com
# Folder holding fullchain.pem and privkey.pem (default ./deploy/certs); ACME_DIR is the certbot webroot (default ./deploy/acme).
# TLS_CERT_DIR=./deploy/certs
# ACME_DIR=./deploy/acme
# HTTP_PORT=80
# HTTPS_PORT=443
# The server's own port is published on this machine only; SERVER_BIND=0.0.0.0 opens it to the network (plain http).
# SERVER_BIND=127.0.0.1

# --- Desktop releases: bearer token for POST /api/admin/releases (leave empty to disable the endpoint) ---
RELEASE_TOKEN=

# --- Desktop shell: the website the Electron window loads (baked in at build time; asked for when not set) ---
OS_PLANNER_SERVER_URL=http://localhost:3000

# --- Operations (README "Running it": logs, health, metrics, rate limits) ---
# LOG_LEVEL: error | warn | log (default) | debug | verbose. LOG_FORMAT: json (default in production) or text.
# LOG_REQUESTS=true logs one line per API request (id, method, path without query string or secrets, status, time, who).
# LOG_LEVEL=log
# LOG_FORMAT=json
# LOG_REQUESTS=true
# /api/metrics (Prometheus format) answers instance administrators, and a scraper holding this token (>= 32 characters).
# METRICS_TOKEN=
# Multiplies every request limit (2 = twice the room, for many people behind one address).
# RATE_LIMIT_FACTOR=1
