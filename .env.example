# Copy to .env and adjust. Never commit the real .env.

NODE_ENV=development
PORT=3000

# Public origin users type into the browser. Used for links in emails and to decide
# whether cookies get the Secure flag. In dev the Angular dev server (4200) proxies /api to :3000.
APP_URL=http://localhost:4200

# --- Where the website talks to the API ---
# Builds of the website (npm run build) ask for this when it is not set. Leave it empty when the API is served from the
# same origin as the website (the default setup). It ends up in the build's config.json and can be edited there later.
#   OS_PLANNER_API_URL=https://api.example.com
OS_PLANNER_API_URL=
# Websites (origins, comma-separated) allowed to call this API from another origin. APP_URL is always allowed.
CORS_ORIGINS=
# Refresh-cookie SameSite: strict (same site, incl. subdomains of one domain), lax, or none (unrelated domains; needs an https APP_URL).
COOKIE_SAMESITE=strict

# --- Database (MySQL 8.4) ---
MYSQL_PORT=3306
DATABASE_URL=mysql://notes:notes@localhost:3306/notes
SHADOW_DATABASE_URL=mysql://notes:notes@localhost:3306/notes_shadow

# --- Secrets (>= 32 chars, generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))") ---
JWT_ACCESS_SECRET=change-me-access-secret-change-me-access
JWT_MEDIA_SECRET=change-me-media-secret-change-me-media-

# --- Mail ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="OS_Planner <no-reply@os-planner.local>"

# --- Storage ---
DATA_DIR=./data
MAX_IMAGE_MB=20
MAX_VIDEO_MB=500
USER_QUOTA_MB=2048
# Defaults for teams and projects (an instance admin can override any of them per user, team or project).
# PROJECT_QUOTA_MB=0 means a project is limited only by its team.
TEAM_QUOTA_MB=10240
PROJECT_QUOTA_MB=0
MAX_MEMBERS_PER_TEAM=100
MAX_PROJECTS_PER_TEAM=50
# Roles of one team (team and project roles together, @everyone not counted).
MAX_ROLES_PER_TEAM=100
# The audit log keeps entries this long; a nightly job removes older ones.
AUDIT_RETENTION_DAYS=365

# --- Instance administrators: comma-separated email addresses. Only a verified address counts. ---
# They get an Administration area (accounts, quota overrides, creating teams).
ADMIN_EMAILS=

# --- HTTPS reverse proxy (docker compose --profile prod --profile proxy; see README "HTTPS reverse proxy") ---
# Then also set APP_URL=https://<OS_PLANNER_DOMAIN> and TRUST_PROXY=true.
# OS_PLANNER_DOMAIN=planner.example.com
# Folder holding fullchain.pem and privkey.pem (default ./deploy/certs); ACME_DIR is the certbot webroot (default ./deploy/acme).
# TLS_CERT_DIR=./deploy/certs
# ACME_DIR=./deploy/acme
# HTTP_PORT=80
# HTTPS_PORT=443
# The server's own port is published on this machine only; SERVER_BIND=0.0.0.0 opens it to the network (plain http).
# SERVER_BIND=127.0.0.1

# --- Desktop releases: bearer token for POST /api/admin/releases (leave empty to disable the endpoint) ---
RELEASE_TOKEN=

# --- Desktop shell: the website the Electron window loads (baked in at build time; asked for when not set) ---
OS_PLANNER_SERVER_URL=http://localhost:3000
