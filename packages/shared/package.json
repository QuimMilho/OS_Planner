{
  "name": "@os-planner/shared",
  "version": "1.0.0",
  "private": true,
  "description": "Document schema, validation, Markdown interop, print renderer and DTOs shared by server and web",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./lite": {
      "types": "./dist/lite.d.ts",
      "import": "./dist/lite.js",
      "require": "./dist/lite.cjs"
    },
    "./chat": {
      "types": "./dist/chat.d.ts",
      "import": "./dist/chat.js",
      "require": "./dist/chat.cjs"
    },
    "./boards": {
      "types": "./dist/boards.d.ts",
      "import": "./dist/boards.js",
      "require": "./dist/boards.cjs"
    },
    "./calendar": {
      "types": "./dist/calendar.d.ts",
      "import": "./dist/calendar.js",
      "require": "./dist/calendar.cjs"
    },
    "./ics": {
      "types": "./dist/ics.d.ts",
      "import": "./dist/ics.js",
      "require": "./dist/ics.cjs"
    },
    "./collab": {
      "types": "./dist/collab.d.ts",
      "import": "./dist/collab.js",
      "require": "./dist/collab.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build-assets.mjs clean && tsup && node scripts/build-assets.mjs assets",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tiptap/core": "^3.35.0",
    "@tiptap/extension-code-block-lowlight": "^3.35.0",
    "@tiptap/extension-details": "^3.35.0",
    "@tiptap/extension-highlight": "^3.35.0",
    "@tiptap/extension-list": "^3.35.0",
    "@tiptap/extension-mathematics": "^3.35.0",
    "@tiptap/extension-subscript": "^3.35.0",
    "@tiptap/extension-superscript": "^3.35.0",
    "@tiptap/extension-table": "^3.35.0",
    "@tiptap/extension-text-align": "^3.35.0",
    "@tiptap/extension-text-style": "^3.35.0",
    "@tiptap/extension-youtube": "^3.35.0",
    "@tiptap/html": "^3.35.0",
    "@tiptap/markdown": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "@tiptap/y-tiptap": "^3.3.1",
    "fractional-indexing": "^4.0.0",
    "happy-dom": "^21.0.4",
    "katex": "0.18.10",
    "lowlight": "^3.3.0",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "chart.js": "^4.6.2",
    "highlight.js": "^11.12.0",
    "mermaid": "^12.3.0",
    "tsup": "^9.0.0",
    "vitest": "^5.1.2"
  }
}
