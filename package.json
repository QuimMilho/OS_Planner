{
  "name": "os-planner",
  "version": "1.0.0",
  "private": true,
  "description": "Rich note-taking website: Angular PWA + NestJS/MySQL server + Electron desktop shell",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait mysql mailpit",
    "db:down": "docker compose down",
    "build": "npm run build -w @os-planner/shared && npm run build -w @os-planner/web && npm run build -w @os-planner/server",
    "test": "npm run test:scripts && npm run test -w @os-planner/shared && npm run test -w @os-planner/server",
    "e2e": "node --test --test-concurrency=1 \"apps/web/e2e/*.e2e.mjs\"",
    "build:shared": "npm run build -w @os-planner/shared",
    "test:shared": "npm run test -w @os-planner/shared",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:scripts": "node --test \"scripts/lib/*.test.mjs\"",
    "check:themes": "node scripts/check-theme-contrast.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "load": "node scripts/load/run.mjs",
    "soak": "node scripts/load/soak.mjs",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "docs:config": "node scripts/env-doc.mjs",
    "check:bundle": "node scripts/check-bundle.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3"
  }
}
