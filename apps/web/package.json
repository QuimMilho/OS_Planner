{
  "name": "@notes/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "prepare:assets": "node ../../scripts/copy-print-assets.mjs",
    "start": "npm run prepare:assets && node ../../scripts/configure-web.mjs --no-prompt && ng serve",
    "build": "npm run prepare:assets && node ../../scripts/configure-web.mjs && ng build",
    "watch": "npm run prepare:assets && node ../../scripts/configure-web.mjs --no-prompt && ng build --watch --configuration development",
    "test": "ng test --watch=false"
  },
