{
  "name": "@notes/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Notes desktop app: a native window around the Notes website",
  "author": "Notes",
  "homepage": "https://github.com/",
  "license": "UNLICENSED",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/prepare.mjs",
    "start": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --x64 --config electron-builder.yml",
    "dist:linux": "node scripts/dist-linux.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --test-concurrency=1 \"e2e/*.e2e.mjs\""
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "^26.18.0",
    "typescript": "~6.0.3"
  }
}
